<Window x:Class="V2SubAuto.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V2SubAuto — V2RayN Subscription Automator"
        Width="1060" Height="720"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="V2SubAuto" FontSize="20" FontWeight="Bold"/>
                        <Border x:Name="StatusBadge" Background="#1E3A5F" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatusBadge" Text="Idle" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Local URL: " Foreground="{StaticResource TextMuted}" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSubUrl" Text="http://127.0.0.1:18080/sub" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button Content="Copy URL" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="10,0,0,0" FontSize="11.5" Click="BtnCopySubUrl_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="LanUrlPanel" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LAN URL: " Foreground="{StaticResource TextMuted}" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLanSubUrl" Text="Detecting LAN IP..." Foreground="#34D399" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCopyLanUrl" Content="Copy LAN URL" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="10,0,0,0" FontSize="11.5" Click="BtnCopyLanUrl_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunNow" Content="▶ Run Pipeline Now" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnRunNow_Click"/>
                    <Button x:Name="BtnStopRun" Content="■ Stop" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="0,0,8,0" Click="BtnStopRun_Click"/>
                    <Button Content="Hide to Tray" Style="{StaticResource SecondaryButton}" Click="BtnHideToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCard}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="Dashboard">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Funnel Metric Cards -->
                        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,14">
                            <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="FETCHED" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtFetched" Text="0" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="AFTER DEDUP" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtDedup" Text="0" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PASSED TCPING" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtTcping" Text="0" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PASSED REAL DELAY" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtRealDelay" Text="0" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0F2E22" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="SERVING (FAST)" FontSize="11" Foreground="#6EE7B7"/>
                                    <TextBlock x:Name="TxtServing" Text="0" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Progress Panel -->
                        <Border Grid.Row="1" Background="{StaticResource BgInput}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtStage" Text="Idle" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="TxtScheduleInfo" Text="Next run: —" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PipelineProgress" Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBlue}" Background="#111622" BorderThickness="0"/>
                                <TextBlock x:Name="TxtDetail" Grid.Row="2" Text="Ready" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Surviving Nodes Table -->
                        <DataGrid x:Name="NodesGrid" Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="{StaticResource BgInput}"
                                  RowBackground="{StaticResource BgInput}"
                                  AlternatingRowBackground="#222938"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="{StaticResource BorderSubtle}"
                                  BorderThickness="1"
                                  HorizontalGridLinesBrush="#283044">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#141821"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolLabel}" Width="95"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                                <DataGridTextColumn Header="Server" Binding="{Binding EndpointDisplay}" Width="190"/>
                                <DataGridTextColumn Header="Tcping" Binding="{Binding TcpingDisplay}" Width="85"/>
                                <DataGridTextColumn Header="Real Delay" Binding="{Binding RealDelayDisplay}" Width="95"/>
                                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="95"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: SUBSCRIPTIONS -->
            <TabItem Header="Subscriptions">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewSubName" Grid.Column="0" Margin="0,0,8,0" ToolTip="Subscription Name"/>
                            <TextBox x:Name="TxtNewSubUrl" Grid.Column="1" Margin="0,0,8,0" ToolTip="https://..."/>
                            <Button Grid.Column="2" Content="+ Add URL" Style="{StaticResource PrimaryButton}" Click="BtnAddSub_Click"/>
                        </Grid>

                        <DataGrid x:Name="SubsGrid" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="{StaticResource BgInput}"
                                  RowBackground="{StaticResource BgInput}"
                                  AlternatingRowBackground="#222938"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderBrush="{StaticResource BorderSubtle}"
                                  BorderThickness="1"
                                  HorizontalGridLinesBrush="#283044"
                                  CellEditEnding="SubsGrid_CellEditEnding"
                                  RowEditEnding="SubsGrid_RowEditEnding"
                                  Sorting="SubsGrid_Sorting"
                                  LostKeyboardFocus="SubsGrid_LostKeyboardFocus"
                                  Unloaded="SubsGrid_Unloaded">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#141821"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Enabled" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0"
                                                      Click="SubEnabledCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                <DataGridTextColumn Header="Subscription / Config URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Delete Selected" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnDeleteSub_Click"/>
                            <Button Content="Save Subscriptions" Style="{StaticResource PrimaryButton}" Click="BtnSaveSubs_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="Settings">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Startup &amp; Schedule" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkAutoStart" Content="Auto-start on Windows 11 boot"/>
                                    <CheckBox x:Name="ChkStartMinimized" Content="Start minimized to system tray"/>
                                    <CheckBox x:Name="ChkRunOnStartup" Content="Run pipeline immediately on startup"/>
                                    <CheckBox x:Name="ChkAutoSchedule" Content="Enable automatic refresh interval"/>

                                    <TextBlock Text="Refresh Interval (minutes)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,4"/>
                                    <TextBox x:Name="TxtIntervalMin"/>

                                    <TextBlock Text="Local Subscription Server" FontSize="15" FontWeight="Bold" Margin="0,20,0,8"/>
                                    <TextBlock Text="Local HTTP Port (serves /sub &amp; /raw)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtLocalPort"/>

                                    <CheckBox x:Name="ChkAllowLan" Content="Allow LAN / local network access (other devices)" Margin="0,10,0,4" ToolTip="Bind the HTTP server to 0.0.0.0 so phones, tablets, and other devices on your LAN can fetch configs via the LAN URL."/>
                                    <CheckBox x:Name="ChkAppendMetrics" Content="Append [delay | speed] to config remarks" Margin="0,4,0,4"/>

                                    <TextBlock Text="Output Sort Order" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="CmbSortOrder">
                                        <ComboBoxItem Content="Download Speed (Fastest First)" Tag="SpeedDescending"/>
                                        <ComboBoxItem Content="Real Delay (Lowest Latency First)" Tag="DelayAscending"/>
                                    </ComboBox>

                                    <TextBlock Text="Max Output Configs (0 = unlimited)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,4"/>
                                    <TextBox x:Name="TxtMaxOutput"/>

                                    <TextBlock Text="Core Binaries (Xray &amp; sing-box)" FontSize="15" FontWeight="Bold" Margin="0,20,0,8"/>
                                    <TextBlock x:Name="TxtCoreStatus" Text="Checking cores..." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnDownloadCores" Content="Download / Update Latest Xray &amp; sing-box" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnDownloadCores_Click"/>
                                </StackPanel>

                                <!-- Right Column -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pipeline Steps (Enable / Skip)" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkStepDedup" Content="Step 1: Remove duplicates"/>
                                    <CheckBox x:Name="ChkStepTcping" Content="Step 2: Test Tcping &amp; remove invalids"/>
                                    <CheckBox x:Name="ChkStepRealDelay" Content="Step 3: Test Real Delay &amp; remove invalids"/>
                                    <CheckBox x:Name="ChkStepSpeedTest" Content="Step 4: Test Latency &amp; Download Speed &amp; filter"/>

                                    <TextBlock Text="V2RayN Testing &amp; Filtering" FontSize="15" FontWeight="Bold" Margin="0,16,0,8"/>
                                    <CheckBox x:Name="ChkKeepOlderDedup" Content="Keep older config when removing duplicates (KeepOlderDedupl)"/>
                                    <CheckBox x:Name="ChkAllowInsecure" Content="Allow insecure TLS &amp; unencrypted VLESS/Trojan connections" ToolTip="When enabled, unencrypted VLESS/Trojan nodes and insecure TLS certificates are tested (via sing-box or local loopback relay) and included. When disabled, unencrypted VLESS/Trojan nodes are skipped before testing."/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tcping Batch Size" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtTcpingBatch"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tcping Timeout (sec)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtTcpingTimeout"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Real Delay Batch" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRealPingBatch"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Real Delay Timeout (s)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRealPingTimeout"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Speedtest Concurrency" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtMixedConcurrency"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Real Delay Test URL" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="CmbPingUrl" IsEditable="True"/>

                                    <TextBlock Text="Download Speed Test URL" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="CmbSpeedUrl" IsEditable="True"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Speedtest Timeout (sec)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSpeedTimeout"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Min Download Speed (MB/s)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtMinSpeed"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Xray Executable Path" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,14,0,4"/>
                                    <TextBox x:Name="TxtXrayPath"/>

                                    <TextBlock Text="sing-box Executable Path" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,4"/>
                                    <TextBox x:Name="TxtSingboxPath"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Exit App Completely" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnExitApp_Click"/>
                            <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="BtnSaveSettings_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: LOGS -->
            <TabItem Header="Logs">
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TxtLogs" Grid.Row="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 FontSize="12"
                                 Background="#0B0E14"
                                 Foreground="#CBD5E1"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Copy Logs" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCopyLogs_Click"/>
                            <Button Content="Clear Logs" Style="{StaticResource SecondaryButton}" Click="BtnClearLogs_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
